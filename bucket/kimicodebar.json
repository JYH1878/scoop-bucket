{
    "$schema": "https://raw.githubusercontent.com/ScoopInstaller/Scoop/master/schema.json",
    "version": "1.7.1",
    "description": "Windows system tray app that monitors Kimi Code usage quotas and alerts before they run out",
    "homepage": "https://github.com/JYH1878/KimiCodeBar-Windows",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/JYH1878/KimiCodeBar-Windows/releases/download/v1.7.1/KimiCodeBar_1.7.1_x64-portable.zip",
            "hash": "1baf8fdfee9f02229bb169c7cc1eb42e89731440d21bd92d2fdd279bf0f4ea92"
        }
    },
    "bin": "kimicodebar.exe",
    "shortcuts": [
        [
            "kimicodebar.exe",
            "KimiCodeBar"
        ]
    ],
    "checkver": {
        "github": "https://github.com/JYH1878/KimiCodeBar-Windows",
        "regex": "v([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/JYH1878/KimiCodeBar-Windows/releases/download/v$version/KimiCodeBar_$version_x64-portable.zip"
            }
        }
    },
    "notes": [
        "Config and cache live in %APPDATA%\\KimiCodeBar\\ and survive Scoop updates.",
        "首次运行可能被 SmartScreen 拦截：点击 \"更多信息\" → \"仍要运行\" 即可。"
    ]
}
